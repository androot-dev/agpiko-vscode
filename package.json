{
  "name": "agpiko-workspace",
  "displayName": "Agpiko Workspace",
  "description": "Agpiko install zones and product integrity. Lock badges on product paths.",
  "version": "0.4.3",
  "publisher": "agpiko",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "workspaceContains:agpiko.workspace.json",
    "workspaceContains:AGENTS.md"
  ],
  "main": "./extension.js",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/androot-dev/agpiko-vscode.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "agpiko.workspace.reload",
        "title": "Agpiko: Reload workspace zones"
      },
      {
        "command": "agpiko.workspace.showZone",
        "title": "Agpiko: Show zone for current file"
      },
      {
        "command": "agpiko.integrity.verify",
        "title": "Agpiko: Verify product integrity"
      }
    ]
  }
}
